# Copy to .env and adjust. The real .env is git-ignored — never commit secrets.

# --- Infrastructure ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://privateai:privateai_dev_password@127.0.0.1:5432/privateai
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents

# --- Inference service ------------------------------------------------------
# Runs natively on the Apple Silicon host (not in Docker).
INFERENCE_URL=http://127.0.0.1:8001
# Must match INFERENCE_API_KEY of the inference service. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INFERENCE_API_KEY=change-me
INFERENCE_TIMEOUT_SECONDS=120
INFERENCE_MAX_TOKENS=500
INFERENCE_TEMPERATURE=0.2

# --- Models -----------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Must match the embedding model's output dimension.
EMBEDDING_DIM=384
# Load the models during startup instead of on the first RAG request.
PRELOAD_MODELS=true

# --- RAG --------------------------------------------------------------------
RAG_TOP_K=5
RAG_CANDIDATE_K=15
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
MAX_CONTEXT_CHARS=12000

# --- Chat -------------------------------------------------------------------
CHAT_HISTORY_LIMIT=20

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
# Where uploaded PDFs are stored until a worker has ingested them.
UPLOAD_DIR=data/uploads
# Delete the source PDF once its chunks are indexed.
DELETE_SOURCE_AFTER_PROCESSING=true

# --- RabbitMQ / Celery ------------------------------------------------------
# Must match RABBITMQ_USER / RABBITMQ_PASSWORD below. The trailing // is the
# default vhost "/".
CELERY_BROKER_URL=amqp://privateai:privateai_dev_password@127.0.0.1:5672//
# Result backend is optional; document status lives in PostgreSQL. Uses Redis
# database 1 so it never collides with the application cache on database 0.
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_QUEUE=documents
CELERY_MAX_RETRIES=5
CELERY_RETRY_BACKOFF_SECONDS=5
CELERY_RETRY_BACKOFF_MAX_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800
# Prometheus port for the Celery worker. 0 disables it; only meaningful for a
# single-process pool (solo/threads).
WORKER_METRICS_PORT=0

# Consumed by docker-compose for the RabbitMQ container.
RABBITMQ_USER=privateai
RABBITMQ_PASSWORD=privateai_dev_password
RABBITMQ_VHOST=/

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
